FROM python:3.11-slim

WORKDIR /app

# Install system dependencies for OpenCV and postgres
RUN apt-get update && apt-get install -y \
    libgl1-mesa-glx \
    libglib2.0-0 \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

# Install python dependencies
COPY apps/api/requirements.txt requirements_api.txt
COPY ai/requirements.txt requirements_ai.txt
RUN pip install --no-cache-dir -r requirements_api.txt -r requirements_ai.txt

# Copy source
COPY . .

# Run FastAPI
WORKDIR /app/apps/api
EXPOSE 8000
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
