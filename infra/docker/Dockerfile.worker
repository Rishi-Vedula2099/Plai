FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    libgl1-mesa-glx \
    libglib2.0-0 \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY apps/api/requirements.txt requirements_api.txt
COPY ai/requirements.txt requirements_ai.txt
RUN pip install --no-cache-dir -r requirements_api.txt -r requirements_ai.txt

COPY . .

WORKDIR /app/apps/workers
CMD ["celery", "-A", "celery_app.celery_app", "worker", "--loglevel=info"]
